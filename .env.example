# Copy to .env to override defaults. All values are optional.

# docker compose
WEB_PORT=8080
API_WORKERS=2

# API (also read when running uvicorn directly)
MODEL_DIR=models/current
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=604800
CACHE_MAX_ITEMS=4096
MAX_UPLOAD_MB=10
MAX_CONCURRENT_INFERENCES=2
# TTA_VIEWS=2            # defaults to the value the model was calibrated with
# ORT_THREADS=0          # 0 = CPU cores / workers
# CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
